FROM ros:humble-ros-base

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for Federate (Python + build tools + Java for lfc)
# Note: ROS 2 base image already has Python 3
RUN apt-get update && apt-get install -y \
    curl \
    python3-pip \
    python3-venv \
    python3-dev \
    cmake \
    build-essential \
    openjdk-17-jre \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for ROS 2 nodes
RUN pip3 install networkx numpy pyyaml scipy

# Install Lingua Franca Compiler (lfc) using official installer
RUN curl -Ls https://install.lf-lang.org | bash -s cli

# Add lfc to PATH (installer puts it in ~/.local/bin)
ENV PATH="/root/.local/bin:$PATH"

# Set working directory
WORKDIR /ros2_ws

# Copy ALL source packages
COPY src/ /ros2_ws/src/
COPY scripts/ /ros2_ws/scripts/
COPY config/ /ros2_ws/config/

# Compile LF code first (needed for coord package)
RUN cd /ros2_ws/src/coord/lf && \
    lfc -f coordinator.lf

# Source ROS 2 and build ONLY the interfaces package (and dependencies if any)
RUN . /opt/ros/humble/setup.sh && \
    colcon build --packages-select interfaces

# Force install Python packages to system path (standard install)
RUN pip3 install ./src/common ./src/dsm ./src/agent ./src/coord

# Set environment variables for RTI connection
ENV LF_RTI_HOST=172.17.174.183
ENV LF_RTI_PORT=15045
ENV LF_FEDERATION_ID=context-fabric-testbed-2025

# Source the workspace in the entrypoint
RUN echo "source /ros2_ws/install/setup.bash" >> /root/.bashrc

# Default command: run federate 1 (can be overridden)
CMD ["/bin/bash", "-c", "source /ros2_ws/install/setup.bash && /ros2_ws/fed-gen/coordinator/bin/federate__fed1 -i context-fabric-testbed-2025 --rti ${LF_RTI_HOST}:${LF_RTI_PORT}"]

